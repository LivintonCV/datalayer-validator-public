{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://livinton.dev/schemas/dlv-report.schema.json",
  "title": "Data Layer Validator — findings export",
  "description": "What the extension writes as dlv-findings-<host>-<stamp>.json. The HTML report is a view of the same data.",
  "type": "object",
  "required": [
    "reportVersion",
    "exportedAt",
    "extension",
    "run",
    "verdict",
    "counts",
    "findings"
  ],
  "properties": {
    "reportVersion": {
      "type": "string",
      "const": "1.0"
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "extension": {
      "type": "string",
      "const": "data-layer-validator"
    },
    "version": {
      "type": "string",
      "description": "The extension version that wrote it."
    },
    "run": {
      "type": "object",
      "required": [
        "id",
        "name",
        "origin"
      ],
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "origin": {
          "type": "string"
        },
        "startedAt": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Milliseconds since the epoch."
        },
        "endedAt": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "verdict": {
      "type": "object",
      "required": [
        "value",
        "reason"
      ],
      "properties": {
        "value": {
          "type": "string",
          "enum": [
            "ready",
            "not_ready"
          ]
        },
        "reason": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "errors",
              "critical_missing",
              "incomplete"
            ]
          },
          "description": "Empty when the verdict is ready."
        }
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "errors",
        "warnings",
        "affectedEvents",
        "notEvaluated",
        "criticalMissing"
      ],
      "properties": {
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "affectedEvents": {
          "type": "integer",
          "minimum": 0
        },
        "notEvaluated": {
          "type": "integer",
          "minimum": 0
        },
        "criticalMissing": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "coverage": {
      "description": "Rules seen over rules in the file; null when the file has no rules.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "seen",
            "total"
          ],
          "properties": {
            "seen": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "conformity": {
      "description": "Judged events without errors over judged events; null when nothing was judged.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "clean",
            "total"
          ],
          "properties": {
            "clean": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ruleId",
          "severity",
          "event",
          "field"
        ],
        "properties": {
          "ruleId": {
            "type": "string"
          },
          "ruleName": {
            "type": "string"
          },
          "critical": {
            "type": "boolean"
          },
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warning",
              "info"
            ]
          },
          "event": {
            "type": "string"
          },
          "page": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "expected": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "observed": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "hint": {
            "type": "string"
          },
          "business": {
            "type": "string"
          },
          "at": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Milliseconds since the epoch."
          },
          "launchRule": {
            "type": "string",
            "description": "Empty when the event came from no named Launch rule."
          }
        }
      }
    }
  },
  "additionalProperties": true
}
